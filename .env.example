# ========== Obrigatório: banco PostgreSQL (Supabase) ==========
# Use SEMPRE "Session mode" (porta 5432). NÃO use "Transaction mode" (6543) com este projeto.
# No Supabase: Project Settings → Database → Connection string → URI → escolha "Session" (5432).
# Substitua [YOUR-PASSWORD] pela senha do banco do projeto.
#
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"
#
# Exemplo (troque project-ref, região e senha):
# DATABASE_URL="postgresql://postgres.abcdefgh:MinhaS3nha@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require"
#
# Se a senha tiver caracteres especiais (@ # % etc.), codifique em URL (ex: @ → %40).

# ========== Opcional (app) ==========
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_SECRET=change-this-to-random-string-in-production
AUTH_SECRET=your-jwt-secret-key
