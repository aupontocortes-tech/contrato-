# PostgreSQL (Supabase, Neon, Vercel Postgres, etc.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Exemplo Supabase: em Project Settings > Database pegue "Connection string" (URI)
# DATABASE_URL="postgresql://postgres.xxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_SECRET=change-this-to-random-string-in-production
AUTH_SECRET=your-jwt-secret-key
